# Copy to .env and fill in once SQL Server is installed. Nothing in this repo connects to a
# database until you run `npm run prisma:migrate` yourself.
DATABASE_URL="sqlserver://localhost:1433;database=dshirtak;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"

PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

UPLOADS_DIR="./uploads"
PUBLIC_UPLOADS_BASE_URL="http://localhost:4000/uploads"
